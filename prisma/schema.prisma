generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id          String       @id @db.VarChar(64)
  name        String       @db.VarChar(255)
  phone       String       @db.VarChar(64)
  email       String?      @db.VarChar(255)
  package     String       @default("Standard") @db.VarChar(64)
  notes       String?
  status      String       @default("active") @db.VarChar(32)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  invitations Invitation[]

  @@map("saas_clients")
}

model Invitation {
  id         String         @id @db.VarChar(64)
  clientId   String?        @map("client_id") @db.VarChar(64)
  title      String         @db.VarChar(255)
  slug       String         @unique @db.VarChar(255)
  templateId String         @default("netflix") @map("template_id") @db.VarChar(64)
  status     String         @default("draft") @db.VarChar(32)
  eventDate  String?        @map("event_date") @db.VarChar(64)
  viewsCount Int            @default(0) @map("views_count")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  client     Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rsvps      Rsvp[]
  config     WeddingConfig?
  wishes     Wish[]

  @@index([slug], map: "idx_saas_invitations_slug")
  @@map("saas_invitations")
}

model WeddingConfig {
  invitationId String     @id @map("invitation_id") @db.VarChar(64)
  config       Json
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("saas_wedding_configs")
}

model Rsvp {
  id           String      @id @db.VarChar(64)
  invitationId String?     @map("invitation_id") @db.VarChar(64)
  name         String      @db.VarChar(255)
  attendance   String      @db.VarChar(64)
  guestCount   Int         @default(1) @map("guest_count")
  notes        String?
  submittedAt  DateTime    @default(now()) @map("submitted_at") @db.Timestamptz(6)
  invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([invitationId], map: "idx_saas_rsvps_invitation")
  @@map("saas_rsvps")
}

model Wish {
  id           String      @id @db.VarChar(64)
  invitationId String?     @map("invitation_id") @db.VarChar(64)
  name         String      @db.VarChar(255)
  status       String      @default("Hadir") @db.VarChar(64)
  message      String
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([invitationId], map: "idx_saas_wishes_invitation")
  @@map("saas_wishes")
}

model bank_accounts {
  id             BigInt      @id @default(autoincrement())
  invitation_id  BigInt
  bank_name      String      @db.VarChar(255)
  account_number String      @db.VarChar(255)
  account_holder String      @db.VarChar(255)
  created_at     DateTime?   @db.Timestamp(0)
  updated_at     DateTime?   @db.Timestamp(0)
  invitations    invitations @relation(fields: [invitation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bank_accounts_invitation_id_foreign")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String
  expiration Int

  @@index([expiration], map: "cache_expiration_index")
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int

  @@index([expiration], map: "cache_locks_expiration_index")
}

model events {
  id            BigInt      @id @default(autoincrement())
  invitation_id BigInt
  type          String      @db.VarChar(255)
  title         String      @db.VarChar(255)
  date          DateTime    @db.Date
  start_time    DateTime?   @db.Time(0)
  end_time      DateTime?   @db.Time(0)
  venue         String      @db.VarChar(255)
  address       String
  maps_url      String?     @db.VarChar(255)
  created_at    DateTime?   @db.Timestamp(0)
  updated_at    DateTime?   @db.Timestamp(0)
  day           String?     @db.VarChar(255)
  month         String?     @db.VarChar(255)
  year          String?     @db.VarChar(255)
  time          String?     @db.VarChar(255)
  invitations   invitations @relation(fields: [invitation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "events_invitation_id_foreign")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String
  queue      String
  payload    String
  exception  String
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model galleries {
  id            BigInt      @id @default(autoincrement())
  invitation_id BigInt
  image         String      @db.VarChar(255)
  caption       String?     @db.VarChar(255)
  order         Int         @default(0)
  created_at    DateTime?   @db.Timestamp(0)
  updated_at    DateTime?   @db.Timestamp(0)
  invitations   invitations @relation(fields: [invitation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "galleries_invitation_id_foreign")
}

model guests {
  id            BigInt      @id @default(autoincrement())
  invitation_id BigInt
  name          String      @db.VarChar(255)
  created_at    DateTime?   @db.Timestamp(0)
  updated_at    DateTime?   @db.Timestamp(0)
  phone         String?     @db.VarChar(255)
  token         String      @unique(map: "guests_token_unique") @db.VarChar(255)
  invitations   invitations @relation(fields: [invitation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "guests_invitation_id_foreign")
  wishes        wishes[]
}

model invitations {
  id              BigInt          @id @default(autoincrement())
  slug            String          @unique(map: "invitations_slug_unique") @db.VarChar(255)
  groom_name      String          @db.VarChar(255)
  groom_nickname  String?         @db.VarChar(255)
  groom_father    String?         @db.VarChar(255)
  groom_mother    String?         @db.VarChar(255)
  groom_photo     String?         @db.VarChar(255)
  bride_name      String          @db.VarChar(255)
  bride_nickname  String?         @db.VarChar(255)
  bride_father    String?         @db.VarChar(255)
  bride_mother    String?         @db.VarChar(255)
  bride_photo     String?         @db.VarChar(255)
  wedding_date    DateTime        @db.Date
  quote           String?
  quote_source    String?         @db.VarChar(255)
  cover_photo     String?         @db.VarChar(255)
  music           String?         @db.VarChar(255)
  closing_message String?
  created_at      DateTime?       @db.Timestamp(0)
  updated_at      DateTime?       @db.Timestamp(0)
  bank_accounts   bank_accounts[]
  events          events[]
  galleries       galleries[]
  guests          guests[]
  love_stories    love_stories[]
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String
  options        String?
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement())
  queue        String @db.VarChar(255)
  payload      String
  attempts     Int    @db.SmallInt
  reserved_at  Int?
  available_at Int
  created_at   Int

  @@index([queue], map: "jobs_queue_index")
}

model love_stories {
  id            BigInt      @id @default(autoincrement())
  invitation_id BigInt
  title         String      @db.VarChar(255)
  date          DateTime    @db.Date
  description   String
  image         String?     @db.VarChar(255)
  order         Int         @default(0)
  created_at    DateTime?   @db.Timestamp(0)
  updated_at    DateTime?   @db.Timestamp(0)
  invitations   invitations @relation(fields: [invitation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "love_stories_invitation_id_foreign")
}

model migrations {
  id        Int    @id @default(autoincrement())
  migration String @db.VarChar(255)
  batch     Int
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement())
  tokenable_type String    @db.VarChar(255)
  tokenable_id   BigInt
  name           String
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([expires_at], map: "personal_access_tokens_expires_at_index")
  @@index([tokenable_type, tokenable_id], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt?
  ip_address    String? @db.VarChar(45)
  user_agent    String?
  payload       String
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model users {
  id                BigInt    @id @default(autoincrement())
  name              String    @db.VarChar(255)
  email             String    @unique(map: "users_email_unique") @db.VarChar(255)
  email_verified_at DateTime? @db.Timestamp(0)
  password          String    @db.VarChar(255)
  remember_token    String?   @db.VarChar(100)
  created_at        DateTime? @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)
}

model wishes {
  id         BigInt    @id @default(autoincrement())
  name       String    @db.VarChar(255)
  message    String
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  guest_id   BigInt
  guests     guests    @relation(fields: [guest_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "wishes_guest_id_foreign")
}
